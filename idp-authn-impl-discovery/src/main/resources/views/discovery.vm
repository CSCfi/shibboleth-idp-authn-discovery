#set ($flowList = $authenticationDiscoveryContext.getFlowsWithAuthorities())
<!DOCTYPE html>
<html>
  #set ($discoFlowId = $authenticationContext.getAttemptedFlow().getId())
  <head>
    <meta charset="utf-8">
    <title>#springMessageText("idp.title", "Web Login Service")</title>
    <link rel="stylesheet" type="text/css" href="$request.getContextPath()/css/main.css">
  </head>
  <body>
    <div class="wrapper">
      <div class="container">
        <header>
          <img src="$request.getContextPath()#springMessage("idp.logo")" alt="#springMessageText("idp.logo.alt-text", "logo")">
        </header>
        <div class="content">
          <div class="column one">
            #foreach ($mapEntry in $flowList)
              #if ($mapEntry.first != $discoFlowId)
                #if ($mapEntry.second)
                  #set ($messageKey = $mapEntry.first + "." + $mapEntry.second + ".message")
                  #set ($defaultMessage = $mapEntry.first + "." + $mapEntry.second)
                #else
                  #set ($messageKey = $mapEntry.first + ".message")
                  #set ($defaultMessage = $mapEntry.first)
                #end
                <form method="post" action="$flowExecutionUrl">
                  <input type="hidden" name="j_authnflow" value="$encoder.encodeForHTMLAttribute($mapEntry.first)"/>
                  #if ($mapEntry.second)
                    <input type="hidden" name="j_authnauthority" value="$encoder.encodeForHTMLAttribute($mapEntry.second)"/>
                  #end
                  <input type="hidden" name="_eventId_proceed" value="_eventId_proceed"/>
                  #if($csrfToken)
                    <input type="hidden" name="${csrfToken.parameterName}" value="${csrfToken.token}"/>
                  #end
                  <button type="submit" class="c-login-button">#springMessageText($messageKey, $encoder.encodeForHTML($defaultMessage))</button>
                </form>
              #end
            #end
          </div>
        </div>
      </div>
      <footer>
    <div class="container container-footer">
          <p class="footer-text">#springMessageText("idp.footer", "Insert your footer text here.")</p>
        </div>
      </footer>
    </div>
  </body>
</html>
